{
  "db_name": "SQLite",
  "query": "\n                    SELECT\n                         c.id AS \"id: _\",\n                         c.name,\n                         c.group_master_key,\n                         c.group_revision,\n                         c.group_members AS \"group_members: _\",\n                         c.muted AS \"muted: _\",\n                         c.expire_timer\n                    FROM channels c\n                    ORDER BY (\n                        SELECT MAX(m.arrived_at)\n                        FROM messages m\n                        WHERE m.channel_id = c.id AND m.edit IS NULL\n                    ) DESC\n                ",
